<Window x:Class="SpotAnalysis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spot Analysis" Height="820" Width="1280" MinHeight="640" MinWidth="980"
        Background="{DynamicResource ColorWorkspace}"
        FontFamily="{DynamicResource FontBody}" FontSize="14"
        AutomationProperties.Name="Spot Analysis workspace"
        KeyboardNavigation.TabNavigation="Local">
  <Grid Background="{DynamicResource ColorWorkspace}" Margin="{DynamicResource SpacingWindow}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" MinHeight="300" />
      <RowDefinition Height="220" MinHeight="170" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="260" />
      <ColumnDefinition Width="*" MinWidth="420" />
      <ColumnDefinition Width="350" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <!-- Header: light workspace chrome; black is reserved for the image surface. -->
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource ColorPanel}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="8" Padding="20,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource ColorAccent}" CornerRadius="5" Padding="8,4" Margin="0,0,12,0">
            <TextBlock Foreground="White" FontWeight="Bold" Text="SA" />
          </Border>
          <StackPanel>
            <TextBlock Style="{DynamicResource PageTitle}" Text="Spot Analysis" />
            <TextBlock Style="{DynamicResource SupportingText}" FontSize="12" Text="Prototype A · traceable workspace" />
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="WorkspaceIdentityText" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Foreground="{DynamicResource ColorMuted}" Text="Input workflow · analysis record" />
      </DockPanel>
    </Border>

    <!-- Region 1: configuration. Its own scroll surface keeps the main path usable at small heights. -->
    <Border x:Name="ConfigurationRegion" Grid.Row="1" Grid.Column="0" Style="{DynamicResource PanelBorder}" Margin="0,12,8,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
        <StackPanel Margin="{DynamicResource SpacingPanelContent}">
          <TextBlock Style="{DynamicResource SectionHeading}" Text="01 · 输入与配置" />
          <TextBlock Style="{DynamicResource SupportingText}" Margin="{DynamicResource SpacingSectionIntro}" Text="打开图片后自动生成预览；复核 ROI 后一次确认正式结果。" />
          <Button x:Name="OpenInputButton" AutomationProperties.AutomationId="OpenInputButton" AutomationProperties.Name="打开受支持的 PNG 图片"
                  AutomationProperties.HelpText="打开一张或多张受支持的灰度或等通道 RGB PNG 图片" Width="230" HorizontalAlignment="Left" Click="OpenPng_Click" Content="_打开 PNG 图片" TabIndex="0" />
          <TextBlock Style="{DynamicResource FieldLabel}" Text="图片工作项" />
          <ListBox x:Name="ImageItemsList" MinHeight="76" MaxHeight="150" Margin="0,4,0,4"
                   AutomationProperties.Name="图片工作项列表" SelectionChanged="ImageItemsList_SelectionChanged" TabIndex="1" />
          <TextBlock Style="{DynamicResource SupportingText}" FontSize="12" Text="状态：未处理、预览、待复核、正式、警告、失败、已导出" TextWrapping="Wrap" />
          <TextBlock Style="{DynamicResource FieldLabel}" Text="Selected input" />
          <TextBlock x:Name="InputSummaryText" Text="No input selected" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <CheckBox x:Name="LockRoiCheck" Margin="0,8,0,0" Content="锁定当前 ROI 并应用到后续图片" AutomationProperties.Name="锁定当前 ROI 并应用到后续图片" Click="LockRoiCheck_Click" />
          <Button x:Name="ApplyCalibrationBatchButton" Style="{DynamicResource SecondaryButton}" Margin="0,6,0,0" Width="230" HorizontalAlignment="Left"
                  Content="将可信标定应用到当前批次" AutomationProperties.Name="将可信标定应用到当前批次" Click="ApplyCalibrationBatch_Click" />

          <Separator Margin="{DynamicResource SpacingSeparator}" />
          <TextBlock Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" Text="Spatial calibration (units per pixel)" />
          <WrapPanel Margin="0,2,0,0">
            <TextBox x:Name="CalibrationXText" Width="58" Margin="0,0,5,5" ToolTip="X length per pixel (optional until calibration is known)" AutomationProperties.Name="X calibration" TextChanged="ConfigurationChanged" TabIndex="1" />
            <TextBox x:Name="CalibrationYText" Width="58" Margin="0,0,5,5" ToolTip="Y length per pixel (optional until calibration is known)" AutomationProperties.Name="Y calibration" TextChanged="ConfigurationChanged" TabIndex="2" />
            <TextBox x:Name="CalibrationUnitsText" Width="62" Margin="0,0,5,5" ToolTip="Physical unit" AutomationProperties.Name="Calibration physical unit" TextChanged="ConfigurationChanged" TabIndex="3" />
            <TextBox x:Name="CalibrationSourceText" Width="84" Margin="0,0,5,5" ToolTip="Calibration provenance" AutomationProperties.Name="Calibration source" TextChanged="ConfigurationChanged" TabIndex="4" />
          </WrapPanel>
          <ComboBox x:Name="CalibrationStatus" Width="140" HorizontalAlignment="Left" Margin="0,2,0,0" AutomationProperties.Name="Calibration confirmation status" ToolTip="Calibration must be confirmed before analysis" SelectionChanged="ConfigurationSelectionChanged" TabIndex="5">
            <ComboBoxItem Content="missing" IsSelected="True" />
            <ComboBoxItem Content="provisional" />
            <ComboBoxItem Content="confirmed" />
          </ComboBox>

          <TextBlock Style="{DynamicResource FieldLabel}" Margin="{DynamicResource SpacingSectionLabel}" Text="Analysis region x, y, width, height" />
          <WrapPanel>
            <TextBox x:Name="RoiXText" Width="50" Text="0" Margin="0,0,4,5" AutomationProperties.Name="Analysis region X" TextChanged="ConfigurationChanged" TabIndex="6" />
            <TextBox x:Name="RoiYText" Width="50" Text="0" Margin="0,0,4,5" AutomationProperties.Name="Analysis region Y" TextChanged="ConfigurationChanged" TabIndex="7" />
            <TextBox x:Name="RoiWidthText" Width="62" Margin="0,0,4,5" AutomationProperties.Name="Analysis region width" ToolTip="Set a confirmed ROI after opening the input" TextChanged="ConfigurationChanged" TabIndex="8" />
            <TextBox x:Name="RoiHeightText" Width="62" Margin="0,0,0,5" AutomationProperties.Name="Analysis region height" ToolTip="Set a confirmed ROI after opening the input" TextChanged="ConfigurationChanged" TabIndex="9" />
          </WrapPanel>

          <TextBlock Style="{DynamicResource FieldLabel}" Margin="{DynamicResource SpacingSectionLabel}" Text="Background / preprocessing (profile-controlled)" />
          <WrapPanel>
            <TextBox x:Name="BackgroundXText" Width="50" Margin="0,0,4,5" AutomationProperties.Name="Background region X" TextChanged="ConfigurationChanged" TabIndex="10" />
            <TextBox x:Name="BackgroundYText" Width="50" Margin="0,0,4,5" AutomationProperties.Name="Background region Y" TextChanged="ConfigurationChanged" TabIndex="11" />
            <TextBox x:Name="BackgroundWidthText" Width="62" Margin="0,0,4,5" AutomationProperties.Name="Background region width" TextChanged="ConfigurationChanged" TabIndex="12" />
            <TextBox x:Name="BackgroundHeightText" Width="62" Margin="0,0,0,5" AutomationProperties.Name="Background region height" TextChanged="ConfigurationChanged" TabIndex="13" />
          </WrapPanel>
          <TextBlock Style="{DynamicResource SupportingText}" FontSize="12" Text="A confirmed background region is required; it is never silently replaced by a whole-image default." />

          <Expander x:Name="AdvancedSettingsExpander" Header="Advanced settings (optional; profile-supported only)" IsExpanded="False" Margin="0,12,0,0" AutomationProperties.Name="Advanced analysis settings">
            <StackPanel Margin="4,8,0,0">
              <TextBlock Style="{DynamicResource SupportingText}" Text="The standard branch is retained. Changes are recorded and results are downgraded for review." TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{DynamicResource FieldLabel}" Text="Filtering" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="AdvancedFiltering" Width="110" SelectedValue="none" AutomationProperties.Name="Advanced filtering" SelectionChanged="ConfigurationSelectionChanged">
                  <ComboBoxItem Content="none" />
                  <ComboBoxItem Content="gaussian" />
                </ComboBox>
                <TextBlock Style="{DynamicResource FieldLabel}" Text="DPC" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox x:Name="AdvancedDpc" Width="110" SelectedValue="none" AutomationProperties.Name="Advanced DPC" SelectionChanged="ConfigurationSelectionChanged">
                  <ComboBoxItem Content="none" />
                  <ComboBoxItem Content="gradient" />
                </ComboBox>
              </StackPanel>
              <TextBlock x:Name="AdvancedSettingsStatus" Style="{DynamicResource SupportingText}" Margin="0,6,0,0" Text="Using recommended defaults" />
              <Button x:Name="ResetAdvancedSettingsButton" Style="{DynamicResource SecondaryButton}" Content="Reset to recommended defaults" Width="230" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ResetAdvancedSettings_Click" />
            </StackPanel>
          </Expander>

          <Button x:Name="ConfirmConfigurationButton" AutomationProperties.AutomationId="ConfirmConfigurationButton" AutomationProperties.Name="确认分析区域并生成正式结果"
                  Margin="0,16,0,0" Width="230" HorizontalAlignment="Left" Click="ConfirmConfiguration_Click" Content="_确认分析区域并生成正式结果" TabIndex="14" />
          <TextBlock Style="{DynamicResource FieldLabel}" Text="Pending request snapshot" />
          <TextBox x:Name="SummaryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                   VerticalScrollBarVisibility="Auto" Text="No pending request" AutomationProperties.Name="Pending request snapshot" IsTabStop="False" />
          <TextBlock Style="{DynamicResource FieldLabel}" Text="05 · 执行分析" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="RunAnalysisButton" AutomationProperties.Name="生成正式结果（兼容入口）" Width="140" Click="RunAnalysis_Click" Content="_生成正式结果" IsEnabled="False" Visibility="Collapsed" TabIndex="15" />
            <Button x:Name="CancelAnalysisButton" Style="{DynamicResource SecondaryButton}" AutomationProperties.Name="Cancel analysis" Margin="6,0,0,0" Width="82" Click="CancelAnalysis_Click" Content="_Cancel" TabIndex="16" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Region 2: central display gets the star-sized column and no competing scroll surface. -->
    <Border x:Name="ImageRegion" Grid.Row="1" Grid.Column="1" Style="{DynamicResource PanelBorder}" Margin="4,12,4,12" Background="{DynamicResource ColorImageBackground}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ColorPanel}" Padding="10,8" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,0,0,1">
          <WrapPanel>
            <TextBlock Foreground="{DynamicResource ColorInk}" VerticalAlignment="Center" FontWeight="SemiBold" Text="图层" Margin="0,0,6,0" />
            <ComboBox x:Name="DisplayLayerCombo" Width="132" AutomationProperties.Name="显示图层" SelectionChanged="DisplaySettingsChanged" TabIndex="22">
              <ComboBoxItem Content="输入图像" Tag="Input" IsSelected="True"/><ComboBoxItem Content="校正强度图" Tag="CorrectedIntensity"/><ComboBoxItem Content="正信号图" Tag="PositiveSignal"/><ComboBoxItem Content="拟合图" Tag="Fit"/><ComboBoxItem Content="残差图" Tag="Residual"/><ComboBoxItem Content="测量 mask" Tag="MeasurementMask"/><ComboBoxItem Content="核心 mask" Tag="CoreMask"/>
            </ComboBox>
            <TextBlock Foreground="{DynamicResource ColorInk}" VerticalAlignment="Center" FontWeight="SemiBold" Text="色图" Margin="12,0,6,0" />
            <ComboBox x:Name="DisplayColorCombo" Width="92" AutomationProperties.Name="显示色图" SelectionChanged="DisplaySettingsChanged" TabIndex="23">
              <ComboBoxItem Content="灰度" Tag="Grayscale" IsSelected="True"/><ComboBoxItem Content="伪彩" Tag="Pseudocolor"/>
            </ComboBox>
            <TextBlock Foreground="{DynamicResource ColorInk}" VerticalAlignment="Center" FontWeight="SemiBold" Text="范围" Margin="12,0,6,0" />
            <ComboBox x:Name="DisplayRangeCombo" Width="96" AutomationProperties.Name="显示范围" SelectionChanged="DisplaySettingsChanged" TabIndex="24">
              <ComboBoxItem Content="分位数" Tag="Percentile" IsSelected="True"/><ComboBoxItem Content="全范围" Tag="Full"/><ComboBoxItem Content="固定" Tag="Fixed"/>
            </ComboBox>
            <Button x:Name="HideOverlaysButton" Style="{DynamicResource SecondaryButton}" Content="隐藏全部覆盖层" Margin="10,0,0,0" Padding="8,4" Click="HideOverlays_Click" AutomationProperties.Name="隐藏全部覆盖层" TabIndex="25" />
          </WrapPanel>
        </Border>
        <Grid Grid.Row="1">
          <Image x:Name="InputPreview" Margin="18" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Input display image" />
          <Canvas x:Name="DisplayOverlayCanvas" Margin="18" IsHitTestVisible="False" />
          <StackPanel x:Name="ImageEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
            <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="No input image" />
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource ColorImageText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="Open a grayscale PNG to view the display image." />
          </StackPanel>
          <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Padding="9,5" Background="{DynamicResource ColorImageOverlay}" CornerRadius="4">
            <TextBlock x:Name="DisplayLayerStatusText" Foreground="White" Text="Display image · input data" />
          </Border>
          <GridSplitter Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Resize configuration and image regions" AutomationProperties.Name="Resize configuration and image regions" />
        </Grid>
      </Grid>
    </Border>

    <!-- Region 3: independent results/exports scroll separately from configuration. -->
    <Border x:Name="ResultsRegion" Grid.Row="1" Grid.Column="2" Style="{DynamicResource PanelBorder}" Margin="8,12,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
        <StackPanel Margin="{DynamicResource SpacingPanelContent}">
          <TextBlock Style="{DynamicResource SectionHeading}" Text="Status &amp; results" />
          <TextBlock Style="{DynamicResource SupportingText}" Margin="0,4,0,0" Text="Current workflow and immutable analysis record" />
          <TextBlock Style="{DynamicResource FieldLabel}" Text="Workflow status" />
          <Border x:Name="WorkflowStatusBadge" Style="{DynamicResource StatusBadge}" AutomationProperties.LiveSetting="Polite">
            <TextBox x:Name="StatusText" Text="Ready" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.Name="Workflow status" TextChanged="StatusText_Changed" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0" />
          </Border>
          <ProgressBar x:Name="AnalysisProgressBar" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="0" IsHitTestVisible="False" AutomationProperties.Name="Analysis progress" />
          <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Style="{DynamicResource SupportingText}" Text="Ready for an input image." AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="RecordText" Margin="0,14,0,0" TextWrapping="Wrap" />
          <TextBlock Style="{DynamicResource FieldLabel}" Text="Measured metrics &amp; validity" />
          <TextBlock x:Name="MetricsText" Text="No result available" TextWrapping="Wrap" />
          <Border Margin="0,12,0,0" Padding="8" Background="{DynamicResource ColorPanelSubtle}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="4">
            <TextBlock Style="{DynamicResource SupportingText}" FontSize="12" Text="Validity legend: ✓ valid · ! caution / review · × invalid · — unavailable. Text labels remain visible without relying on color." />
          </Border>
          <Separator Margin="{DynamicResource SpacingSeparator}" />
          <TextBlock FontWeight="SemiBold" Text="Report export" />
          <TextBox x:Name="ReportNameText" Margin="0,6,0,0" Text="" AutomationProperties.Name="Report name (optional)" TabIndex="17" />
          <CheckBox x:Name="ReportTimestampCheck" Content="Append UTC timestamp" IsChecked="True" AutomationProperties.Name="Append UTC timestamp" TabIndex="18" />
          <Button x:Name="ExportResultButton" Style="{DynamicResource SecondaryButton}" Margin="0,10,0,0" Width="210" HorizontalAlignment="Left" Click="ExportResult_Click" Content="Export PDF/PNG report" IsEnabled="False" AutomationProperties.Name="Export PDF or PNG report" TabIndex="19" />
          <Separator Margin="0,18,0,12" />
          <TextBlock FontWeight="SemiBold" Text="Diagnostics &amp; about" />
          <TextBlock x:Name="DiagnosticsText" Margin="0,5,0,0" TextWrapping="Wrap" />
          <Button x:Name="ExportDiagnosticsButton" Style="{DynamicResource SecondaryButton}" Margin="0,8,0,0" Width="180" HorizontalAlignment="Left" Click="ExportDiagnostics_Click" Content="Export diagnostics" AutomationProperties.Name="Export diagnostics" TabIndex="20" />
          <CheckBox x:Name="IncludeOriginalImageCheck" Content="Attach original image explicitly" AutomationProperties.Name="Attach original image explicitly" TabIndex="21" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Region 4: simultaneous X/Y profiles and energy explanation. -->
    <Border x:Name="CurvesRegion" Grid.Row="2" Grid.ColumnSpan="3" Style="{DynamicResource PanelBorder}" Margin="0,0,0,0" Padding="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <TextBlock Style="{DynamicResource SectionHeading}" Text="Explanation curves" />
          <TextBlock x:Name="CurveIdentityText" Margin="14,3,0,0" Style="{DynamicResource SupportingText}" />
          <TextBlock x:Name="CurveStatusText" Margin="14,3,0,0" Style="{DynamicResource SupportingText}" FontWeight="SemiBold" />
        </DockPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,0,1,0" Margin="0,0,8,0">
            <Grid><Canvas x:Name="XProfileCanvas" SizeChanged="CurveCanvas_SizeChanged" AutomationProperties.Name="X center profile curve" />
              <TextBlock VerticalAlignment="Top" Style="{DynamicResource SupportingText}" FontSize="12" Text="X center profile · position (px), intensity (code)" />
              <TextBlock VerticalAlignment="Bottom" Style="{DynamicResource SupportingText}" FontSize="12" Text="actual — solid   fitted — dashed" /></Grid>
          </Border>
          <Border Grid.Column="1" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,0,1,0" Margin="8,0,8,0">
            <Grid><Canvas x:Name="YProfileCanvas" SizeChanged="CurveCanvas_SizeChanged" AutomationProperties.Name="Y center profile curve" />
              <TextBlock VerticalAlignment="Top" Style="{DynamicResource SupportingText}" FontSize="12" Text="Y center profile · position (px), intensity (code)" />
              <TextBlock VerticalAlignment="Bottom" Style="{DynamicResource SupportingText}" FontSize="12" Text="actual — solid   fitted — dashed" /></Grid>
          </Border>
          <Grid Grid.Column="2" Margin="8,0,0,0"><Canvas x:Name="EnergyCanvas" SizeChanged="CurveCanvas_SizeChanged" AutomationProperties.Name="Cumulative energy curve" />
            <TextBlock VerticalAlignment="Top" Style="{DynamicResource SupportingText}" FontSize="12" Text="Radius–cumulative energy · radius (record unit), fraction" />
            <TextBlock x:Name="EnergyMarkerText" VerticalAlignment="Bottom" Style="{DynamicResource SupportingText}" FontSize="12" /></Grid>
          <StackPanel x:Name="CurvesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="650">
            <TextBlock x:Name="CurvesEmptyStateText" Style="{DynamicResource SupportingText}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Text="No analysis result yet — curves will appear here after a successful run." AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
