<Window x:Class="SpotAnalysis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spot Analysis" Height="820" Width="1280" MinHeight="640" MinWidth="980">
  <Grid Background="#FFF7F8FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="190" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="260" />
      <ColumnDefinition Width="*" MinWidth="420" />
      <ColumnDefinition Width="360" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#FF1F2937" Padding="20,0">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="White"
                   FontSize="22" FontWeight="SemiBold" Text="Spot Analysis · Prototype A workspace" />
        <TextBlock x:Name="WorkspaceIdentityText" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Foreground="#FFD1D5DB" Text="Input workflow · analysis record" />
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#FFE5E7EB" BorderThickness="0,0,1,0" Background="White">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,16,16,18">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="01 · 输入与配置" />
          <TextBlock Margin="0,5,0,12" Foreground="#FF6B7280" Text="Choose an input, confirm analysis choices, then run." TextWrapping="Wrap" />
          <Button x:Name="OpenInputButton" AutomationProperties.AutomationId="OpenInputButton"
                  Width="230" HorizontalAlignment="Left" Click="OpenPng_Click" Content="Open grayscale PNG" />
          <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Selected input" />
          <TextBlock x:Name="InputSummaryText" Text="No input selected" TextWrapping="Wrap" />

          <Separator Margin="0,16,0,12" />
          <TextBlock FontWeight="SemiBold" Text="Spatial calibration (units per pixel)" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBox x:Name="CalibrationXText" Width="55" Text="1" Margin="0,0,5,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="CalibrationYText" Width="55" Text="1" Margin="0,0,5,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="CalibrationUnitsText" Width="55" Text="mm" Margin="0,0,5,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="CalibrationSourceText" Width="75" Text="user" TextChanged="ConfigurationChanged" />
          </StackPanel>
          <ComboBox x:Name="CalibrationStatus" Width="130" HorizontalAlignment="Left" Margin="0,6,0,0" SelectionChanged="ConfigurationSelectionChanged">
            <ComboBoxItem Content="missing" IsSelected="True" />
            <ComboBoxItem Content="provisional" />
            <ComboBoxItem Content="confirmed" />
          </ComboBox>

          <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Analysis region x, y, width, height" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="RoiXText" Width="48" Text="0" Margin="0,0,4,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="RoiYText" Width="48" Text="0" Margin="0,0,4,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="RoiWidthText" Width="58" Text="1" Margin="0,0,4,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="RoiHeightText" Width="58" Text="1" TextChanged="ConfigurationChanged" />
          </StackPanel>
          <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Background / preprocessing (optional)" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="BackgroundXText" Width="48" Margin="0,0,4,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="BackgroundYText" Width="48" Margin="0,0,4,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="BackgroundWidthText" Width="58" Margin="0,0,4,0" TextChanged="ConfigurationChanged" />
            <TextBox x:Name="BackgroundHeightText" Width="58" TextChanged="ConfigurationChanged" />
          </StackPanel>
          <TextBlock Margin="0,4,0,0" Foreground="#FF6B7280" Text="Background correction is recorded only when all four values are provided." TextWrapping="Wrap" />

          <Button x:Name="ConfirmConfigurationButton" AutomationProperties.AutomationId="ConfirmConfigurationButton"
                  Margin="0,16,0,0" Width="230" HorizontalAlignment="Left" Click="ConfirmConfiguration_Click" Content="Confirm configuration" />
          <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Pending request" />
          <TextBox x:Name="SummaryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                   VerticalScrollBarVisibility="Auto" Text="No pending request" />
          <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="05 · 执行分析" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="RunAnalysisButton" Width="140" Click="RunAnalysis_Click" Content="Run real analysis" IsEnabled="False" />
            <Button Margin="6,0,0,0" Width="70" Click="CancelAnalysis_Click" Content="Cancel" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Margin="12" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="4" Background="#FF111827">
      <Grid>
        <Image x:Name="InputPreview" Margin="18" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <StackPanel x:Name="ImageEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Foreground="#FFD1D5DB" FontSize="20" HorizontalAlignment="Center" Text="No input image" />
          <TextBlock Margin="0,6,0,0" Foreground="#FF9CA3AF" HorizontalAlignment="Center" Text="Open a grayscale PNG to view the display image." />
        </StackPanel>
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Padding="8,4" Background="#AA111827" CornerRadius="3">
          <TextBlock Foreground="White" Text="Display image · input data" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#FFE5E7EB" BorderThickness="1,0,0,0" Background="White">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="Status &amp; results" />
          <TextBlock Margin="0,4,0,0" Foreground="#FF6B7280" Text="Current workflow and immutable analysis record" TextWrapping="Wrap" />
          <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Workflow status" />
          <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
          <TextBlock x:Name="RecordText" Margin="0,14,0,0" TextWrapping="Wrap" />
          <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Measured metrics &amp; validity" />
          <TextBlock x:Name="MetricsText" Text="No result available" TextWrapping="Wrap" />
          <Separator Margin="0,16,0,12" />
          <TextBlock FontWeight="SemiBold" Text="Report export" />
          <TextBox x:Name="ReportNameText" Margin="0,6,0,0" Text="spot-analysis-report" />
          <CheckBox x:Name="ReportTimestampCheck" Margin="0,6,0,0" Content="Append UTC timestamp" />
          <Button x:Name="ExportResultButton" Margin="0,10,0,0" Width="210" HorizontalAlignment="Left" Click="ExportResult_Click" Content="Export PDF/PNG report" IsEnabled="False" />
          <Separator Margin="0,18,0,12" />
          <TextBlock FontWeight="SemiBold" Text="Diagnostics &amp; about" />
          <TextBlock x:Name="DiagnosticsText" Margin="0,5,0,0" TextWrapping="Wrap" />
          <Button Margin="0,8,0,0" Width="180" HorizontalAlignment="Left" Click="ExportDiagnostics_Click" Content="Export diagnostics" />
          <CheckBox x:Name="IncludeOriginalImageCheck" Margin="0,6,0,0" Content="Attach original image explicitly" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="12,0,12,12" Padding="12" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="4" Background="White">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="Explanation curves" />
          <TextBlock x:Name="CurveIdentityText" Margin="14,2,0,0" Foreground="#FF6B7280" />
          <TextBlock x:Name="CurveStatusText" Margin="14,2,0,0" Foreground="#FFB45309" />
        </DockPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#FFE5E7EB" BorderThickness="0,0,1,0" Margin="0,0,8,0">
            <Grid><Canvas x:Name="XProfileCanvas" SizeChanged="CurveCanvas_SizeChanged" />
              <TextBlock VerticalAlignment="Top" Foreground="#FF6B7280" Text="X center profile · position (px), intensity (code)" />
              <TextBlock VerticalAlignment="Bottom" Foreground="#FF6B7280" Text="actual — solid   fitted — dashed" /></Grid>
          </Border>
          <Border Grid.Column="1" BorderBrush="#FFE5E7EB" BorderThickness="0,0,1,0" Margin="8,0,8,0">
            <Grid><Canvas x:Name="YProfileCanvas" SizeChanged="CurveCanvas_SizeChanged" />
              <TextBlock VerticalAlignment="Top" Foreground="#FF6B7280" Text="Y center profile · position (px), intensity (code)" />
              <TextBlock VerticalAlignment="Bottom" Foreground="#FF6B7280" Text="actual — solid   fitted — dashed" /></Grid>
          </Border>
          <Grid Grid.Column="2" Margin="8,0,0,0"><Canvas x:Name="EnergyCanvas" SizeChanged="CurveCanvas_SizeChanged" />
            <TextBlock VerticalAlignment="Top" Foreground="#FF6B7280" Text="Radius–cumulative energy · radius (record unit), fraction" />
            <TextBlock x:Name="EnergyMarkerText" VerticalAlignment="Bottom" Foreground="#FF6B7280" /></Grid>
          <StackPanel x:Name="CurvesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="CurvesEmptyStateText" Foreground="#FF6B7280" FontSize="14" HorizontalAlignment="Center" Text="No analysis result yet — curves will appear here after a successful run." />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
