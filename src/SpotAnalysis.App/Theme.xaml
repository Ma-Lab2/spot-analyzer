<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Prototype A visual tokens. Keep workflow semantics in WorkspacePresentationModel. -->
  <SolidColorBrush x:Key="ColorWorkspace" Color="#EAF6EE" />
  <SolidColorBrush x:Key="ColorPanel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ColorPanelSubtle" Color="#F5FBF7" />
  <SolidColorBrush x:Key="ColorInk" Color="#17382D" />
  <SolidColorBrush x:Key="ColorMuted" Color="#4C665B" />
  <SolidColorBrush x:Key="ColorBorder" Color="#B9D3C4" />
  <SolidColorBrush x:Key="ColorAccent" Color="#087F73" />
  <SolidColorBrush x:Key="ColorAccentDark" Color="#07564F" />
  <SolidColorBrush x:Key="ColorFocus" Color="#005A9C" />
  <SolidColorBrush x:Key="ColorInfo" Color="#075D82" />
  <SolidColorBrush x:Key="ColorInfoSurface" Color="#E4F2F8" />
  <SolidColorBrush x:Key="ColorSuccess" Color="#176A45" />
  <SolidColorBrush x:Key="ColorSuccessSurface" Color="#E6F4EC" />
  <SolidColorBrush x:Key="ColorCaution" Color="#7A4A00" />
  <SolidColorBrush x:Key="ColorCautionSurface" Color="#FFF4D6" />
  <SolidColorBrush x:Key="ColorInvalid" Color="#A62B2B" />
  <SolidColorBrush x:Key="ColorInvalidSurface" Color="#FDE8E7" />
  <SolidColorBrush x:Key="ColorUnavailable" Color="#48535A" />
  <SolidColorBrush x:Key="ColorUnavailableSurface" Color="#EEF1F2" />
  <SolidColorBrush x:Key="ColorImageBackground" Color="#101A17" />
  <SolidColorBrush x:Key="ColorImageText" Color="#D5E5DF" />
  <SolidColorBrush x:Key="ColorImageOverlay" Color="#CC101A17" />

  <FontFamily x:Key="FontBody">Segoe UI</FontFamily>
  <Thickness x:Key="SpacingWindow">14</Thickness>
  <Thickness x:Key="SpacingPanelContent">18,16,16,18</Thickness>
  <Thickness x:Key="SpacingSectionLabel">0,12,0,4</Thickness>
  <Thickness x:Key="SpacingSectionIntro">0,5,0,12</Thickness>
  <Thickness x:Key="SpacingSeparator">0,16,0,12</Thickness>
  <Thickness x:Key="SpacingCompact">0,6,0,0</Thickness>
  <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">5</CornerRadius>
  <Style x:Key="FocusVisualStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border BorderBrush="{DynamicResource ColorFocus}" BorderThickness="2" CornerRadius="3" Margin="-3">
            <AdornedElementPlaceholder />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ColorInk}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>
  <Style x:Key="SupportingText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource ColorMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource ColorAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentDark}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ColorAccentDark}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#043C38" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6E7C75" /><Setter Property="Background" Value="#DCE6E0" /><Setter Property="BorderBrush" Value="#C4D1C8" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource ColorAccentDark}" />
    <Setter Property="Background" Value="{DynamicResource ColorPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ColorInk}" />
    <Setter Property="Background" Value="{DynamicResource ColorPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ColorFocus}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6E7C75" /><Setter Property="Background" Value="#EEF3EF" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ColorInk}" />
    <Setter Property="Background" Value="{DynamicResource ColorPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ColorFocus}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6E7C75" /><Setter Property="Background" Value="#EEF3EF" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ColorInk}" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource ColorAccent}" />
    <Setter Property="Background" Value="#DCE9E1" />
  </Style>
  <Style x:Key="PanelBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ColorPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ColorPanelSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
</ResourceDictionary>
