<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\SpotAnalysis.Worker\worker.py" Link="worker.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SpotAnalysis.Worker\png_analysis.py" Link="png_analysis.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\spot_analyzer\**\*.py" Link="spot_analyzer\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\packaging\build-identity.json" Link="build-identity.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
