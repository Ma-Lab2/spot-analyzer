<Window x:Class="SpotAnalysis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spot Analysis" Height="760" Width="720">
  <ScrollViewer>
    <StackPanel Margin="20">
      <TextBlock FontSize="22" Text="Spot Analysis workspace" />
      <TextBlock Margin="0,12,0,4" Text="Selected input" />
      <TextBlock x:Name="InputSummaryText" Text="No input selected" TextWrapping="Wrap" />
      <Image x:Name="InputPreview" Margin="0,8,0,0" MaxHeight="220" MaxWidth="320"
             Stretch="Uniform" HorizontalAlignment="Left" />
      <Button Margin="0,12,0,0" Width="190" HorizontalAlignment="Left"
              Click="OpenPng_Click" Content="Open grayscale PNG" />

      <GroupBox Header="Record-driven display" Margin="0,18,0,0">
        <StackPanel Margin="8">
          <TextBlock x:Name="DisplayIdentityText" Text="No analysis display available" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="Layer" Margin="0,0,6,0" />
            <ComboBox x:Name="DisplayLayerCombo" Width="155" SelectionChanged="DisplaySettingChanged">
              <ComboBoxItem Content="Input image" Tag="Input" IsSelected="True" />
              <ComboBoxItem Content="Corrected intensity" Tag="CorrectedIntensity" />
              <ComboBoxItem Content="Positive signal" Tag="PositiveSignal" />
              <ComboBoxItem Content="Fit" Tag="Fit" />
              <ComboBoxItem Content="Residual" Tag="Residual" />
              <ComboBoxItem Content="Measurement mask" Tag="MeasurementMask" />
              <ComboBoxItem Content="Core mask" Tag="CoreMask" />
            </ComboBox>
            <TextBlock VerticalAlignment="Center" Text="Color" Margin="12,0,6,0" />
            <ComboBox x:Name="DisplayColorCombo" Width="105" SelectionChanged="DisplaySettingChanged">
              <ComboBoxItem Content="Grayscale" Tag="Grayscale" IsSelected="True" />
              <ComboBoxItem Content="Pseudocolor" Tag="Pseudocolor" />
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="Range" Margin="0,0,6,0" />
            <ComboBox x:Name="DisplayRangeCombo" Width="105" SelectionChanged="DisplaySettingChanged">
              <ComboBoxItem Content="Percentile" Tag="Percentile" IsSelected="True" />
              <ComboBoxItem Content="Full" Tag="Full" />
              <ComboBoxItem Content="Fixed" Tag="Fixed" />
            </ComboBox>
            <TextBox x:Name="DisplayMinimumText" Width="70" Margin="8,0,4,0" Text="0" TextChanged="DisplaySettingChanged" />
            <TextBox x:Name="DisplayMaximumText" Width="70" Text="1" TextChanged="DisplaySettingChanged" />
          </StackPanel>
          <WrapPanel Margin="0,8,0,0">
            <CheckBox x:Name="DisplayCenterCheck" Content="Center" IsChecked="True" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" />
            <CheckBox x:Name="DisplayRoiCheck" Content="ROI" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" />
            <CheckBox x:Name="DisplayAxesCheck" Content="Axes" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" />
            <CheckBox x:Name="DisplayUnitsCheck" Content="Units" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" />
            <CheckBox x:Name="DisplayLegendCheck" Content="Legend" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" />
            <Button Content="Hide overlays and legend" Margin="12,0,0,0" Click="HideDisplayOverlays_Click" />
          </WrapPanel>
          <Grid Margin="0,10,0,0" MaxHeight="420" MaxWidth="620" HorizontalAlignment="Left" SizeChanged="DisplaySurface_SizeChanged">
            <Image x:Name="DisplayImage" Stretch="Uniform" />
            <Canvas x:Name="DisplayOverlayCanvas" IsHitTestVisible="False" />
          </Grid>
          <TextBlock x:Name="DisplayOverlayText" Margin="0,6,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="DisplayFeedbackText" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </GroupBox>

      <TextBlock Margin="0,16,0,4" Text="Spatial calibration (units per pixel)" />
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="CalibrationXText" Width="70" Text="1" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="CalibrationYText" Width="70" Text="1" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="CalibrationUnitsText" Width="70" Text="mm" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="CalibrationSourceText" Width="150" Text="user" TextChanged="ConfigurationChanged" />
      </StackPanel>
      <ComboBox x:Name="CalibrationStatus" Width="130" HorizontalAlignment="Left" Margin="0,6,0,0"
                SelectionChanged="ConfigurationSelectionChanged">
        <ComboBoxItem Content="missing" IsSelected="True" />
        <ComboBoxItem Content="provisional" />
        <ComboBoxItem Content="confirmed" />
      </ComboBox>
      <TextBlock Margin="0,12,0,4" Text="Analysis region x, y, width, height (input pixels)" />
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="RoiXText" Width="55" Text="0" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="RoiYText" Width="55" Text="0" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="RoiWidthText" Width="65" Text="1" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="RoiHeightText" Width="65" Text="1" TextChanged="ConfigurationChanged" />
      </StackPanel>
      <TextBlock Margin="0,12,0,4" Text="Background region (optional): x, y, width, height" />
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="BackgroundXText" Width="55" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="BackgroundYText" Width="55" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="BackgroundWidthText" Width="65" Margin="0,0,6,0" TextChanged="ConfigurationChanged" />
        <TextBox x:Name="BackgroundHeightText" Width="65" TextChanged="ConfigurationChanged" />
      </StackPanel>
      <Button Margin="0,12,0,0" Width="190" HorizontalAlignment="Left"
              Click="ConfirmConfiguration_Click" Content="Confirm configuration" />
      <TextBlock Margin="0,12,0,4" Text="Pending analysis request (read-only snapshot)" />
      <TextBox x:Name="SummaryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="140" VerticalScrollBarVisibility="Auto"
               Text="No pending request" />

    <Border Grid.Row="1" Grid.Column="1" Margin="12" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="4" Background="#FF111827">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="12">
          <TextBlock x:Name="DisplayIdentityText" Foreground="White" Text="No analysis display available" TextWrapping="Wrap" />
          <TextBlock Foreground="#FFD1D5DB" Text="Display image · input data" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="White" Text="Layer" Margin="0,0,6,0" />
            <ComboBox x:Name="DisplayLayerCombo" Width="155" SelectionChanged="DisplaySettingChanged">
              <ComboBoxItem Content="Input image" Tag="Input" IsSelected="True" /><ComboBoxItem Content="Corrected intensity" Tag="CorrectedIntensity" /><ComboBoxItem Content="Positive signal" Tag="PositiveSignal" /><ComboBoxItem Content="Fit" Tag="Fit" /><ComboBoxItem Content="Residual" Tag="Residual" /><ComboBoxItem Content="Measurement mask" Tag="MeasurementMask" /><ComboBoxItem Content="Core mask" Tag="CoreMask" />
            </ComboBox>
            <TextBlock VerticalAlignment="Center" Foreground="White" Text="Color" Margin="12,0,6,0" />
            <ComboBox x:Name="DisplayColorCombo" Width="105" SelectionChanged="DisplaySettingChanged"><ComboBoxItem Content="Grayscale" Tag="Grayscale" IsSelected="True" /><ComboBoxItem Content="Pseudocolor" Tag="Pseudocolor" /></ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="White" Text="Range" Margin="0,0,6,0" />
            <ComboBox x:Name="DisplayRangeCombo" Width="105" SelectionChanged="DisplaySettingChanged"><ComboBoxItem Content="Percentile" Tag="Percentile" IsSelected="True" /><ComboBoxItem Content="Full" Tag="Full" /><ComboBoxItem Content="Fixed" Tag="Fixed" /></ComboBox>
            <TextBox x:Name="DisplayMinimumText" Width="60" Margin="8,0,4,0" Text="0" TextChanged="DisplaySettingChanged" /><TextBox x:Name="DisplayMaximumText" Width="60" Text="1" TextChanged="DisplaySettingChanged" />
          </StackPanel>
          <WrapPanel Margin="0,8,0,0">
            <CheckBox x:Name="DisplayCenterCheck" Foreground="White" Content="Center" IsChecked="True" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" /><CheckBox x:Name="DisplayRoiCheck" Foreground="White" Content="ROI" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" /><CheckBox x:Name="DisplayAxesCheck" Foreground="White" Content="Axes" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" /><CheckBox x:Name="DisplayUnitsCheck" Foreground="White" Content="Units" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" /><CheckBox x:Name="DisplayLegendCheck" Foreground="White" Content="Legend" IsChecked="True" Margin="10,0,0,0" Checked="DisplaySettingChanged" Unchecked="DisplaySettingChanged" /><Button Content="Hide overlays" Margin="12,0,0,0" Click="HideDisplayOverlays_Click" />
          </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="12" SizeChanged="DisplaySurface_SizeChanged"><Image x:Name="DisplayImage" Stretch="Uniform" /><Canvas x:Name="DisplayOverlayCanvas" IsHitTestVisible="False" /></Grid>
        <StackPanel Grid.Row="2" Margin="12"><TextBlock x:Name="DisplayOverlayText" Foreground="White" TextWrapping="Wrap" /><TextBlock x:Name="DisplayFeedbackText" Foreground="#FFD1D5DB" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
        <Image x:Name="InputPreview" Visibility="Collapsed" />
        <StackPanel x:Name="ImageEmptyState" Visibility="Collapsed" />
      </Grid>
    </Border>

      <TextBlock Margin="0,18,0,4" Text="Diagnostics and about" />
      <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Width="180" Click="ExportDiagnostics_Click" Content="Export diagnostics" />
        <CheckBox x:Name="IncludeOriginalImageCheck" Margin="10,4,0,0"
                  Content="Attach original image explicitly" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
